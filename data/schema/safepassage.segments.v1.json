{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SafePassage Segment Schema v1",
  "description": "Frozen contract for all road-segment GeoJSON features. Both frontend and backend must conform to this shape.",
  "type": "object",
  "required": ["type", "geometry", "properties"],
  "properties": {
    "type": {
      "type": "string",
      "const": "Feature"
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "description": "Array of [longitude, latitude] vertices in WGS84"
        }
      }
    },
    "properties": {
      "type": "object",
      "required": [
        "segment_id",
        "highway_name",
        "risk_score",
        "confidence",
        "observation_count",
        "species_mix",
        "endangered_flag",
        "season_curve",
        "intervention",
        "model_version"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^SEG-[0-9]{6}$",
          "description": "Unique segment identifier, ordered by descending risk score"
        },
        "highway_name": {
          "type": "string",
          "description": "Highway identifier, e.g. NH-766"
        },
        "highway_class": {
          "type": "string",
          "description": "OSM highway class, e.g. trunk, primary"
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Ranked risk score 0-100"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Model-reported confidence"
        },
        "observation_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Roadkill observations joined to this segment"
        },
        "species_mix": {
          "type": "object",
          "description": "Count of observations by taxon class",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "endangered_flag": {
          "type": "boolean",
          "description": "True if any endangered/protected species present"
        },
        "season_curve": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 12,
          "maxItems": 12,
          "description": "Monthly collision counts Jan-Dec"
        },
        "length_km": {
          "type": "number",
          "minimum": 0,
          "description": "Segment length in kilometres"
        },
        "intervention": {
          "type": "string",
          "enum": ["wildlife_crossing", "fencing", "signage", "speed_limit", "none"],
          "description": "Recommended intervention type"
        },
        "model_version": {
          "type": "string",
          "description": "Version tag of the model that produced this score"
        }
      }
    }
  }
}
